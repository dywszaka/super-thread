{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["electron.vite.config.ts", "src/**/*", "tests/**/*"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  }
}
